{
  "Cors": {
    "AllowedOrigins": [
      "https://preco-certo-saqua.vercel.app",
      "http://localhost:8081",
      "http://127.0.0.1:8081"
    ]
  },
  "AllowedHosts": "*",
  "Clima": {
    "CacheMinutos": 15,
    "CacheStaleHoras": 6,
    "PrecisaoCoordenadas": 2,
    "TimeoutSegundos": 8
  },
  "Jwt": {
    "Issuer": "PrecoCerto",
    "Audience": "PrecoCertoApp",
    "ExpirationHours": 24
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
