# =============================================================================
# Variáveis do app Expo (Mobile)
#
# Desenvolvimento local: copie para Mobile/.env
#   cp .env.example .env
#
# Vercel (web): Project Settings → Environment Variables
#   Root Directory = Mobile
#   Build Command  = npm run build:web
#   Output Directory = dist
#   (ver Mobile/vercel.json)
#
# Todas as variáveis públicas do Expo devem começar com EXPO_PUBLIC_
# =============================================================================

# --- API (obrigatório) ---
# ⚠️  SEMPRE com https:// — sem protocolo o browser trata como path relativo (erro 405 na Vercel)
#
# Dev local (browser em http://localhost:8081 — o app também força isso em __DEV__ web):
EXPO_PUBLIC_API_URL=http://localhost:5132/api
#
# Dev no celular (Expo Go) na mesma rede — IPv4 atual do PC (`ip -4 addr` / ipconfig):
# EXPO_PUBLIC_API_URL=http://192.168.1.99:5132/api
#
# Produção Vercel — uma linha só, com https e /api. Redeploy depois de mudar:
# EXPO_PUBLIC_API_URL=https://SEU-SERVICO.up.railway.app/api
# Após alterar na Vercel: faça REDEPLOY (variáveis EXPO_PUBLIC_* entram no build)

# --- Supabase (obrigatório para upload de fotos de produto) ---
# Supabase → Project Settings → API
#   Project URL  → EXPO_PUBLIC_SUPABASE_URL
#   anon public  → EXPO_PUBLIC_SUPABASE_ANON_KEY
# NÃO use URL do dashboard (supabase.com/dashboard/project/...).
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY

# --- Google Maps (opcional — geocoding de endereço) ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# =============================================================================
# Checklist Vercel (Production)
# =============================================================================
# [ ] EXPO_PUBLIC_API_URL = https://....up.railway.app/api
# [ ] EXPO_PUBLIC_SUPABASE_URL = https://SEU_PROJECT_REF.supabase.co
# [ ] EXPO_PUBLIC_SUPABASE_ANON_KEY = (anon key do Supabase)
# [ ] Redeploy após alterar variáveis (build embute EXPO_PUBLIC_*)
