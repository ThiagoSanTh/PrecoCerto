# Copie para .env (dev) ou configure na Vercel (Production → Environment Variables).
# Na Vercel: Root Directory = Mobile | Build = npm run build:web | Output = dist
# Dev local:
EXPO_PUBLIC_API_URL=http://localhost:5132/api
# Produção (Railway) — OBRIGATÓRIO https:// e terminar com /api:
# EXPO_PUBLIC_API_URL=https://preco-certo-api-production.up.railway.app/api

# Google Geocoding (opcional)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Supabase (upload de fotos de produto)
# NÃO use a URL do navegador (supabase.com/dashboard/...).
# Supabase → Project Settings → API:
#   Project URL  → EXPO_PUBLIC_SUPABASE_URL   (ex.: https://abcdefgh.supabase.co)
#   anon public  → EXPO_PUBLIC_SUPABASE_ANON_KEY
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
