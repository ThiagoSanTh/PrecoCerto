{
  "expo": {
    "name": "Preço Certo",
    "slug": "preco-certo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O Preço Certo usa sua localização para encontrar lojas e ofertas próximas a você."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Preço Certo",
      "shortName": "Preço Certo",
      "themeColor": "#14B8A6",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "startUrl": "/",
      "orientation": "portrait",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Preço Certo usa sua localização para encontrar lojas e ofertas próximas a você."
        }
      ]
    ]
  }
}
